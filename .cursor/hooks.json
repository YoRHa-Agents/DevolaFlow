{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|StrReplace",
        "command": ".cursor/hooks/devola-boundary.sh"
      },
      {
        "command": "[ ! -f \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\" ] || node \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\"",
        "timeout": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/devola-boundary.sh"
      }
    ],
    "sessionStart": [
      {
        "command": ".cursor/hooks/devola-session.sh"
      }
    ]
  }
}
