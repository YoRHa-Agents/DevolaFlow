{
  "host": "copilot",
  "provenance": "vendor-doc",
  "provenance_ref": "https://docs.github.com/en/copilot/reference/hooks-configuration",
  "cases": [
    {
      "name": "native_edit",
      "input": {
        "toolName": "edit",
        "toolArgs": {"file_path": "src/demo.py", "old_string": "a", "new_string": "b"}
      },
      "expected": {"kind": "file_write", "path": "src/demo.py"}
    },
    {
      "name": "native_bash",
      "input": {
        "toolName": "bash",
        "toolArgs": {"command": "pytest tests/ -q"}
      },
      "expected": {"kind": "shell", "command": "pytest tests/ -q"}
    }
  ]
}
