{
  "host": "claude",
  "cases": [
    {
      "name": "pretooluse_write",
      "input": {
        "tool_name": "Write",
        "tool_input": {"file_path": "src/demo.py", "content": "print('hi')"}
      },
      "expected": {"kind": "file_write", "path": "src/demo.py"}
    },
    {
      "name": "pretooluse_edit",
      "input": {
        "tool_name": "Edit",
        "tool_input": {"file_path": "src/demo.py", "old_string": "a", "new_string": "b"}
      },
      "expected": {"kind": "file_write", "path": "src/demo.py"}
    },
    {
      "name": "pretooluse_bash",
      "input": {
        "tool_name": "Bash",
        "tool_input": {"command": "make test-harness", "description": "run harness"}
      },
      "expected": {"kind": "shell", "command": "make test-harness"}
    }
  ]
}
