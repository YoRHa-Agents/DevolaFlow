{
  "host": "codex",
  "cases": [
    {
      "name": "pretooluse_bash",
      "input": {
        "tool_name": "Bash",
        "tool_input": {"command": "ruff check src/ tests/"}
      },
      "expected": {"kind": "shell", "command": "ruff check src/ tests/"}
    },
    {
      "name": "apply_patch_multi_target",
      "input": {
        "tool_name": "apply_patch",
        "tool_input": {
          "input": "*** Begin Patch\n*** Update File: src/a.py\n@@\n-old\n+new\n*** Add File: src/b.py\n+content\n*** Delete File: docs/c.md\n*** End Patch"
        }
      },
      "expected": {
        "kind": "file_write",
        "path": "src/a.py",
        "extra_paths": ["src/b.py", "docs/c.md"]
      }
    },
    {
      "name": "apply_patch_no_extractable_path",
      "input": {
        "tool_name": "apply_patch",
        "tool_input": {"input": "*** Begin Patch\nnot a real patch body\n*** End Patch"}
      },
      "expected": {"kind": "shell", "command": "apply_patch"}
    }
  ]
}
