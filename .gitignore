dist/
_site/

# Node (for demo pages)
node_modules/

# DevolaFlow local workspace (whitelist team-collab subdirs; everything else private)
# Per feedback_for_v12.1.0.md — narrow whitelist replaces v9.2.3 broad ignore.
# Team-tracked: .local/memory/specs/ (A-4) + .local/research/ (W-7/W-19 artifacts).
.local/*
!.local/.gitignore
!.local/memory/
.local/memory/*
!.local/memory/specs/
!.local/memory/specs/**
!.local/research/
# clean_repo Phase A — narrow whitelist: only current-cycle research (v15*)
# + adr/ stay tracked; archived history lives in docs/cycle-archive/ (W-19).
# See .local/tasks/clean_repo/01-phase-A-untrack.md.
.local/research/*
!.local/research/v15*
!.local/research/adr/
!.local/research/adr/**
# v14.0.0 — track the human INPUT zone ONLY (D-4 / ADR-2). The .local/human/*
# re-exclusion keeps output/ + archive/ PRIVATE (D2 locked) while
# !.local/human/input/** re-includes the authoritative INPUT zone.
!.local/human/
.local/human/*
!.local/human/input/
!.local/human/input/**

# Project-local Cursor skill mirror — opt-in, recreated on demand.
# Tracked counterparts live under workflow-system/agent/. Devs who want the
# skill auto-loaded inside the DevolaFlow repo itself can recreate the mirror
# with: make sync-cursor-skill   (or the project-local installer:
#   curl -fsSL https://raw.githubusercontent.com/YoRHa-Agents/DevolaFlow/main/scripts/install.sh | bash -s cursor )
# See .rules/conventions.mdc §C-6 (compiled into .cursor/rules/repo-governance.mdc)
# for the version-consistency parity contract (formerly skill-format SF-3).
.cursor/skills/devola-flow/

# clean_repo Phase A — untracked (kept locally / archived in docs/cycle-archive/).
.cursor/plans/
MIGRATION-v6.md
